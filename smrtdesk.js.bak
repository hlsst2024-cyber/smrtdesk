    var inp=b.parentNode.querySelector(".search-input");
    if(!inp)return;
    b.onclick=function(){var v=inp.value.trim();if(v)window.location="/search.html?s="+encodeURIComponent(v)};
    inp.onkeydown=function(e){if(e.key==="Enter"){var v=inp.value.trim();if(v)window.location="/search.html?s="+encodeURIComponent(v)}}
  })(z[i])}

  // Category carousel arrows
  document.querySelectorAll('.category-carousel-track').forEach(function(track){
    var wrap=track.closest('.category-carousel-wrap');
    if(!wrap)return;
    var prev=wrap.querySelector('.cat-prev'),next=wrap.querySelector('.cat-next');
    function sa(){var c=track.querySelector('.product-card');return c?c.offsetWidth+16:300}
    if(prev)prev.addEventListener('click',function(){track.scrollBy({left:-sa()*4,behavior:'smooth'})});
    if(next)next.addEventListener('click',function(){track.scrollBy({left:sa()*4,behavior:'smooth'})});
  });

  // Footer subscribe
  (function(){ 
    var s=document.querySelector('.footer-subscribe-text'),e=document.querySelector('.footer-input');
    if(s&&e)s.addEventListener('click',function(t){t.preventDefault();var v=e.value.trim();if(v&&v.indexOf('@')>-1&&v.indexOf('.')>-1){alert('Thanks for subscribing!');e.value=''}else alert('Please enter a valid email address')});
  })();

  // Hero carousel
  (function(){
    var slides=document.querySelectorAll('.hero-carousel .hero-slide'),prev=document.getElementById('heroPrev'),next=document.getElementById('heroNext'),c=0;
    if(!slides.length)return;
    function g(i){slides.forEach(function(s,idx){s.classList.toggle('active',idx===i)});c=i}
    if(prev)prev.addEventListener('click',function(){g((c-1+slides.length)%slides.length)});
    if(next)next.addEventListener('click',function(){g((c+1)%slides.length)});
    setInterval(function(){g((c+1)%slides.length)},5000);
  })();

  // Top banner carousel
  (function(){
    var slides=document.querySelectorAll('.banner-slide');
    if(!slides.length)return;
    var c=0,pb=document.querySelector('.banner-prev'),nb=document.querySelector('.banner-next');
    function s(i){slides.forEach(function(sl,idx){sl.classList.toggle('active',idx===i)});c=i}
    s(0);
    if(pb)pb.addEventListener('click',function(){s((c-1+slides.length)%slides.length)});
    if(nb)nb.addEventListener('click',function(){s((c+1)%slides.length)});
    setInterval(function(){s((c+1)%slides.length)},5000);
  })();
})();

/* Product Page Renderer - uses PRODUCTS object */
(function(){
  var params = new URLSearchParams(window.location.search);
  var productId = params.get('id') || params.get('asin');
  if (!productId) return;

  // Look up product in PRODUCTS
  var p = PRODUCTS[productId];
  if (!p) {
    // Try ASIN case-insensitive match
    var idUpper = productId.toUpperCase();
    for (var key in PRODUCTS) {
      if (key.toUpperCase() === idUpper) { p = PRODUCTS[key]; break; }
    }
  }
  if (!p) {
    var nf = document.querySelector('[data-bind="notFound"]');
    if (nf) nf.style.display = 'block';
    document.title = 'Product Not Found | SmrtDesk';
    var prodTitleEl2 = document.querySelector('[data-bind="prodTitle"]');
    if (prodTitleEl2) prodTitleEl2.textContent = 'Product Not Found | SmrtDesk';
    return;
  }

  var amazonUrl = p.amazonLink || 'https://www.amazon.com/dp/' + p.asin + '?tag=smrtdesk-20&linkCode=ogi&th=1&psc=1';
  var catPage = 'category.html?slug=' + p.categorySlug;
  // Page <title> — use same title as category page card for consistency
  var displayTitle = p.titleShort || p.title;
  var metaDesc = 'Read our expert review of ' + p.title + '. Expert-tested with honest pros, cons, specs, and buying guide.';
  document.title = displayTitle;
  // Update static data-bind placeholders for crawlers
  var prodTitleEl = document.querySelector('[data-bind="prodTitle"]');
  if (prodTitleEl) prodTitleEl.textContent = displayTitle;

  // Meta
  var metaEl = document.querySelector('meta[name="description"]');
  if (metaEl) metaEl.setAttribute('content', metaDesc);
  var prodDescEl = document.querySelector('[data-bind="prodDescription"]');
  if (prodDescEl) prodDescEl.setAttribute('content', metaDesc);
  var canEl = document.querySelector('[data-bind="canonical"]');
  if (canEl) canEl.setAttribute('href', 'https://www.smrtdesk.xyz/product.html?asin=' + encodeURIComponent(p.asin));
  var ogt = document.querySelector('[data-bind="ogTitle"]');
  if (ogt) ogt.setAttribute('content', displayTitle);
  var ogd = document.querySelector('[data-bind="ogDescription"]');
  if (ogd) ogd.setAttribute('content', metaDesc);
  var ogu = document.querySelector('[data-bind="ogUrl"]');
  if (ogu) ogu.setAttribute('content', 'https://www.smrtdesk.xyz/product.html?asin=' + encodeURIComponent(p.asin));

  // Breadcrumb
  var cl = document.querySelector('[data-bind="catLink"]');
  if (cl) { cl.setAttribute('href', catPage); cl.textContent = p.categoryName; }

  // Hero
  var ts = document.querySelector('[data-bind="titleShort"]');
  if (ts) ts.textContent = p.titleShort || (p.title.length > 50 ? p.title.substring(0, 47) + '...' : p.title);
  var t = document.querySelector('[data-bind="title"]');
  if (t) t.textContent = displayTitle;

  // Image
  var img = document.querySelector('[data-bind="imageBg"]');
  if (img && p.image) img.style.backgroundImage = "url('" + p.image + "')";

  // Price bar
  var pr = document.querySelector('[data-bind="price"]');
  if (pr) pr.textContent = p.price;
  var st = document.querySelector('[data-bind="stars"]');
  if (st) st.innerHTML = (p.stars || '') + ' ' + p.rating + '/5';
  var al = document.querySelector('[data-bind="amazonLink"]');
  if (al) al.href = amazonUrl;

  // Pros/Cons
  var pros = document.querySelector('[data-bind="pros"]');
  if (pros) { pros.innerHTML = ''; if (p.pros) p.pros.forEach(function(v){ var li=document.createElement('li'); li.textContent=v; pros.appendChild(li); }); }
  var cons = document.querySelector('[data-bind="cons"]');
  if (cons) { cons.innerHTML = ''; if (p.cons) p.cons.forEach(function(v){ var li=document.createElement('li'); li.textContent=v; cons.appendChild(li); }); }

  // Specs
  var specs = document.querySelector('[data-bind="specs"]');
  if (specs) {
    specs.innerHTML = '';
    var rows = [
      ['Brand', p.brand], ['Price', p.price], ['Rating', p.rating + '/5'],
      ['Category', p.categoryName], ['ASIN', p.asin]
    ];
    rows.forEach(function(r){
      var tr = document.createElement('tr');
      tr.innerHTML = '<td style="font-weight:600;color:#333;padding:8px 12px;border-bottom:1px solid #eee;font-size:.82rem;width:120px;">' + r[0] + '</td><td style="padding:8px 12px;border-bottom:1px solid #eee;font-size:.82rem;color:#555;">' + r[1] + '</td>';
      specs.appendChild(tr);
    });
  }

  // Description
  var desc = document.querySelector('[data-bind="description"]');
  if (desc) desc.textContent = p.description || '';

  // Buy button
  var al2 = document.querySelector('[data-bind="amazonLink2"]');
  if (al2) al2.href = amazonUrl;

  // Sidebar
  var cd = document.querySelector('[data-bind="catDesc"]');
  if (cd) cd.textContent = 'This product is part of our ' + p.categoryName + ' reviews.';
  var cb = document.querySelector('[data-bind="catBtn"]');
  if (cb) { cb.href = catPage; cb.textContent = 'View All ' + p.categoryName; }

  // Structured data (LD+JSON)
  var ldjson = document.getElementById('ldjson');
  if (ldjson) {
    // Extract numeric price from p.price (e.g., "$20.49" -> "20.49")
    var priceNum = '99.99';
    if (p.price) {
      var match = p.price.match(/[\d,]+\.?\d*/);
      if (match) priceNum = match[0].replace(/,/g, '');
    }
    var reviewCountInt = parseInt(p.reviewCount, 10) || 0;
    ldjson.textContent = JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Product',
      'name': p.title,
      'description': metaDesc,
      'image': 'https://www.smrtdesk.xyz/' + p.image,
      'sku': p.asin,
      'brand': { '@type': 'Brand', 'name': p.brand },
      'offers': {
        '@type': 'Offer',
        'url': amazonUrl,
        'priceCurrency': 'USD',
        'price': priceNum,
        'availability': 'https://schema.org/InStock',
        'itemCondition': 'https://schema.org/NewCondition'
      },
      'aggregateRating': {
        '@type': 'AggregateRating',
        'ratingValue': p.rating,
        'bestRating': '5',
        'worstRating': '1',
        'reviewCount': reviewCountInt,
        'reviewCountSpecified': reviewCountInt
      },
      'review': {
        '@type': 'Review',
        'name': 'Expert Review of ' + p.title,
        'reviewBody': metaDesc,
        'reviewRating': { '@type': 'Rating', 'ratingValue': p.rating, 'bestRating': '5', 'worstRating': '1' },
        'author': { '@type': 'Organization', 'name': 'SmrtDesk', 'url': 'https://www.smrtdesk.xyz/' }
      }
    }, null, 2);
  }
})();

/* Category -> Product slug alias map: maps menu slug to the product categorySlug values that should appear */
/* Each product categorySlug maps to EXACTLY ONE subcategory to prevent duplicate listings */
var CAT_SLUG_ALIAS = {
  /* Office Furniture: aggregate sub-categories into their parent subcategory */
  "storage-cabinet": ["storage-cabinet","filing-cabinet","vertical-file-cabinet","steel-lockers","garage-cabinets"],
  "storage-shelves": ["storage-shelves"],
  /* Beds: each bed type maps only to itself */
  "twin-over-twin": ["twin-over-twin"],
  "bunk-bed": ["bunk-bed"],
  "loft-bed": ["loft-bed"],
  "heavy-duty-bunk": ["heavy-duty-bunk"],
    "kitchen-storage-organizer": ["kitchen-storage-organizer","cabinet-organizer"],
  "food-storage-container": ["food-storage-container"],
  "kitchen-utensils-gadgets": ["kitchen-utensils-gadgets"],
  "countertop-storage-rack": ["countertop-storage-rack"],
  "bbq-grilling-tools": ["bbq-grilling-tools"],
  /* Camping: each subcategory shows only its own products */
  "camping-outdoors": ["camping-outdoors"],
  "sleeping-gear": ["sleeping-gear"],
  "camp-furniture": ["camp-furniture"],
  "camp-cooking": ["camp-cooking"],
  "camping-lighting": ["camping-lighting"],
  "safety-tools": ["safety-tools"],
  "camping-accessories": ["camping-accessories"],
  /* Electronics: phone-accessories map to cell-phones (best fit); laptop-accessories map to monitor-stand (monitor mounts) */
  "cell-phones": ["cell-phones","phone-accessories"],
  "audio-headphones": ["audio-headphones"],
  "office-electronics": ["office-electronics"],
  "monitor-stand": ["monitor-stand","laptop-accessories"],
  "smart-home": ["smart-home","smart-home-gadgets"],
  "portable-devices": ["portable-devices"],
  "computers-tablets": ["computers-tablets"],
  "cameras": ["cameras"],
  "wearable-tech": ["wearable-tech"],
  "car-electronics": ["car-electronics"],
  "gaming": ["gaming"]
};

/* Category Page Renderer */
(function(){
  var slug = document.querySelector('[data-bind="category"]');
  if (!slug) return;

  // Read slug from URL query param first, fallback to data-value
  var params = new URLSearchParams(window.location.search);
  var catSlug = params.get("slug") || slug.getAttribute("data-value") || "";
  if (!catSlug) return;

  var isSubcategory = false;
  var cat = CATEGORIES[catSlug];
  if (!cat) {
    cat = SUBCATEGORIES[catSlug];
    if (!cat) return;
    isSubcategory = true;
  }

  // Build full breadcrumb for subcategories: Home > Parent Category > Subcategory
  var breadcrumbEl = document.querySelector('[data-bind="catBreadcrumb"]');
  if (breadcrumbEl) {
    if (isSubcategory && cat.parentSlug) {
      var parentCat = CATEGORIES[cat.parentSlug];
      var parentName = parentCat ? parentCat.name : cat.parent;
      var parentLink = "category.html?slug=" + cat.parentSlug;
      breadcrumbEl.innerHTML = '<a href="/">Home</a> <span class="sep">/</span> <a href="' + parentLink + '">' + parentName + '</a> <span class="sep">/</span> <span>' + cat.name + '</span>';
    } else {
      var parentName2 = cat.parent || "Home";
      breadcrumbEl.innerHTML = '<a href="/">Home</a> <span class="sep">/</span> <span>' + cat.name + '</span>';
    }
  }

  // Title
  var titleEl = document.querySelector('[data-bind="catTitle"]');
  if (titleEl) titleEl.textContent = cat.name;

  // Description
  var descEl = document.querySelector('[data-bind="catDescription"]');
  if (descEl) {
    if (cat.description) {
      descEl.textContent = cat.description;
    } else {
      descEl.textContent = "Our expert team reviews the best " + cat.name.toLowerCase() + ". We test for performance, quality, and value so you can buy with confidence.";
    }
  }

  // Top Pick Hero
  var topPickEl = document.querySelector('[data-bind="topPick"]');
  if (topPickEl && cat.topPick) {
    topPickEl.style.display = "flex";
    var tp = cat.topPick;
    var tpTitle = topPickEl.querySelector('[data-bind="tpTitle"]');
    if (tpTitle) tpTitle.textContent = tp.title || "";
    var tpRating = topPickEl.querySelector('[data-bind="tpRating"]');
    if (tpRating) tpRating.innerHTML = tp.rating || "";
    var tpSummary = topPickEl.querySelector('[data-bind="tpSummary"]');
    if (tpSummary) tpSummary.textContent = tp.summary || "";
  } else if (topPickEl) {
    topPickEl.style.display = "none";
  }

  // Subcategory filter pills: show on main category (mobile), hide on subcategory pages
  var subcatRow = document.querySelector('[data-bind="subcatRow"]');
  if (subcatRow) {
    if (!isSubcategory && cat.subcategories) {
      // Mobile: show subcategory filter buttons
      subcatRow.style.display = "block";
      subcatRow.innerHTML = "";
      cat.subcategories.forEach(function(sc){
        var pill = document.createElement("a");
        pill.href = "category.html?slug=" + sc.slug;
        pill.className = "blog-filter-pill";
        pill.textContent = sc.name;
        subcatRow.appendChild(pill);
      });
    } else if (isSubcategory) {
      subcatRow.style.display = "none";
    }
  }

  // Helper: get all product slugs that should appear for a given menu slug
  function getSlugs(menuSlug) {
    var slugs = [];
    slugs.push(menuSlug);
    if (CAT_SLUG_ALIAS[menuSlug]) {
      slugs = slugs.concat(CAT_SLUG_ALIAS[menuSlug]);
    }
    return slugs;
  }

  // Product cards in grid
  var grid = document.querySelector('[data-bind="productGrid"]');
  if (grid) {
    grid.innerHTML = "";
    var catProducts = [];
    var slugs = [];

    if (isSubcategory) {
      slugs = getSlugs(catSlug);
    } else if (cat.subcategories) {
      cat.subcategories.forEach(function(sc){
        slugs = slugs.concat(getSlugs(sc.slug));
      });
      slugs.push(catSlug);
    }

    for (var key in PRODUCTS) {
      if (!PRODUCTS.hasOwnProperty(key)) continue;
      var p = PRODUCTS[key];
      if (slugs.indexOf(p.categorySlug) !== -1) {
        catProducts.push(p);
      }
    }

    // Deduplicate by asin
    var seen = {};
    catProducts = catProducts.filter(function(p){
      if (seen[p.asin]) return false;
      seen[p.asin] = true;
      return true;
    });
    catProducts.sort(function(a,b){ return parseFloat(b.rating) - parseFloat(a.rating); });
    catProducts = catProducts.slice(0, 40);

    if (catProducts.length === 0) {
      grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;padding:40px;color:#888;">No products found in this category yet. Check back soon for new reviews!</p>';
    } else {
      catProducts.forEach(function(p){
        var card = document.createElement("div");
        card.className = "product-card";
        card.innerHTML =
          '<a href="product.html?asin=' + encodeURIComponent(p.asin) + '&name=' + encodeURIComponent(p.titleShort || p.title) + '" class="card-img-link">' +
            '<img class="card-img-square" src="' + (p.image || 'product_images/placeholder.jpg') + '" alt="' + (p.titleShort || p.title) + '" loading="lazy">' +
          '</a>' +
          '<div class="card-body">' +
            '<h3 class="pro-title"><a href="product.html?asin=' + encodeURIComponent(p.asin) + '&name=' + encodeURIComponent(p.titleShort || p.title) + '">' + (p.titleShort || p.title) + '</a></h3>' +
            '<div class="stars">' + (p.stars || '') + ' <span class="rating-text">' + p.rating + '/5</span></div>' +
            '<div class="price-range">' + (p.price ? p.price : 'Check Price') + '</div>' +
            '<a href="https://www.amazon.com/dp/' + encodeURIComponent(p.asin) + '?tag=smrtdesk-20" class="btn-amz" target="_blank" rel="noopener">Check Price \u2192</a>' +
          '</div>';
        grid.appendChild(card);
      });
    }
  }

  // Page title
  if (cat.name) {
    document.title = cat.name + " - Expert Tested | SmrtDesk";
    var catTitleEl = document.querySelector('[data-bind="catTitle"]');
    if (catTitleEl) catTitleEl.textContent = cat.name + " - Expert Tested | SmrtDesk";
  }

  // Meta description
  var metaDesc = document.querySelector('[data-bind="metaDescription"]');
  if (metaDesc) {
    var descText = cat.description || "Our expert team reviews the best " + cat.name.toLowerCase() + ". We test for performance, quality, and value so you can buy with confidence.";
    metaDesc.setAttribute("content", descText);
  }

  // Canonical URL
  var canonicalEl = document.querySelector('[data-bind="catCanonical"]');
  if (canonicalEl) {
    canonicalEl.setAttribute("href", "https://www.smrtdesk.xyz/category.html?slug=" + catSlug);
  }

  // OG tags
  var ogTitle = document.querySelector('[data-bind="ogTitle"]');
  if (ogTitle && cat.name) ogTitle.setAttribute("content", cat.name + " - Expert Tested | SmrtDesk");
  var ogDesc2 = document.querySelector('[data-bind="ogDescription"]');
  if (ogDesc2 && cat.description) ogDesc2.setAttribute("content", cat.description);
  var ogUrl = document.querySelector('[data-bind="ogUrl"]');
  if (ogUrl) ogUrl.setAttribute("content", "https://www.smrtdesk.xyz/category.html?slug=" + catSlug);
})();
/* Article Page Renderer */
(function(){
  var titleEl = document.querySelector('[data-bind="articleTitle"]');
  if (!titleEl) return;

  var slug = (window.location.pathname.match(/article-(.+)\.html/) || ['',''])[1];
  if (!slug) {
    var params = new URLSearchParams(window.location.search);
    slug = params.get('slug') || '';
  }
  if (!slug) return;

  var article = null;
  for (var i = 0; i < ARTICLES.length; i++) {
    if (ARTICLES[i].slug === slug) {
      article = ARTICLES[i];
      break;
    }
  }
  if (!article) return;

  // Fill titles
  var titleEls = document.querySelectorAll('[data-bind="articleTitle"]');
  for (var t = 0; t < titleEls.length; t++) {
    titleEls[t].textContent = article.title;
  }

  // Page title
  document.title = article.title + ' | SmrtDesk';

  // Breadcrumb
  var bc = document.querySelector('[data-bind="articleBreadcrumb"]');
  if (bc && article.categoryName) {
    bc.innerHTML = '<a href="/">Home</a> <span class="sep">/</span> <a href="blog.html">Blog</a> <span class="sep">/</span> <span>' + article.title + '</span>';
  }

  // Article excerpt
  var excerptEl = document.querySelector('[data-bind="articleExcerpt"]');
  if (excerptEl) excerptEl.textContent = article.excerpt || '';

  // Product Image (1:1 square, centered below hero)
  var productImgEl = document.querySelector('[data-bind="productImage"]');
  if (productImgEl && article.image) {
    var imgTag = productImgEl.querySelector('.review-product-img');
    if (imgTag) imgTag.src = article.image;
  }

  // Find matching product in PRODUCTS by ASIN
  var product = null;
  if (article.asin && typeof PRODUCTS !== 'undefined' && PRODUCTS[article.asin]) {
    product = PRODUCTS[article.asin];
  } else if (article.asin && typeof PRODUCTS !== 'undefined') {
    var au = article.asin.toUpperCase();
    for (var pk in PRODUCTS) {
      if (pk.toUpperCase() === au) { product = PRODUCTS[pk]; break; }
    }
  }

  // Article body
  var bodyEl = document.querySelector('[data-bind="articleBody"]');
  if (bodyEl && article.body) bodyEl.innerHTML = article.body;

  // Article meta / date
  var metaEl = document.querySelector('[data-bind="articleMeta"]');
  if (metaEl && article.date) metaEl.innerHTML = 'Updated ' + article.date + ' &middot; By SmrtDesk Editorial Team';

  // Meta description
  var metaDescEl = document.querySelector('[data-bind="metaDescription"]');
  if (metaDescEl && article.excerpt) metaDescEl.setAttribute('content', article.excerpt);

  // Product Info Box (sidebar)
  if (product) {
    var pib = document.querySelector('[data-bind="productInfoBox"]');
    if (pib) {
      var pibRating = pib.querySelector('.product-info-box__rating');
      if (pibRating) pibRating.innerHTML = '<strong>' + product.rating + '</strong> / 5 <span style="color:#f5a623;">' + (product.stars || '') + '</span>';
      var pibPrice = pib.querySelector('.product-info-box__price');
      if (pibPrice) pibPrice.innerHTML = '<strong>' + product.price + '</strong>';
      var pibBtn = pib.querySelector('.product-info-box__btn');
      if (pibBtn) pibBtn.href = product.amazonLink || 'https://www.amazon.com/dp/' + product.asin + '?tag=smrtdesk-20';
    }

    // Pros
    var prosEl = document.querySelector('[data-bind="reviewPros"]');
    if (prosEl) {
      prosEl.innerHTML = '';
      var pros = article.pros || (product.pros || []);
      for (var pi = 0; pi < pros.length; pi++) {
        var li = document.createElement('li');
        li.textContent = pros[pi];
        prosEl.appendChild(li);
      }
    }

    // Cons
    var consEl = document.querySelector('[data-bind="reviewCons"]');
    if (consEl) {
      consEl.innerHTML = '';
      var cons = article.cons || (product.cons || []);
      for (var ci = 0; ci < cons.length; ci++) {
        var li = document.createElement('li');
        li.textContent = cons[ci];
        consEl.appendChild(li);
      }
    }

    // Rating Summary
    var ratingEl = document.querySelector('[data-bind="ratingSummary"]');
    if (ratingEl) {
      var overallScore = ratingEl.querySelector('.rating-overall__score');
      if (overallScore) overallScore.textContent = product.rating;
      var overallCount = ratingEl.querySelector('.rating-overall__count');
      if (overallCount) overallCount.textContent = 'Based on ' + (product.reviewCount || '850') + ' ratings';
    }
  } else {
    // Hide product-specific sections if no product linked
    var pib = document.querySelector('[data-bind="productInfoBox"]');
    if (pib) pib.style.display = 'none';
  }

  // Related articles (by same category)
  var relatedEl = document.querySelector('[data-bind="relatedArticles"]');
  if (relatedEl) {
    var related = [];
    for (var r = 0; r < ARTICLES.length; r++) {
      if (ARTICLES[r].slug !== article.slug && ARTICLES[r].category === article.category) {
        related.push(ARTICLES[r]);
      }
    }
    if (related.length > 0) {
      related = related.slice(0, 4);
      var html = '';
      for (var ri = 0; ri < related.length; ri++) {
        html += '<li><a href="article.html?slug=' + related[ri].slug + '">' + related[ri].title + '</a></li>';
      }
      relatedEl.innerHTML = html;
    }
  }

  // Canonical URL for article pages
  var canon = document.querySelector('[data-bind="canonical"]');
  if (canon) canon.setAttribute('href', 'https://www.smrtdesk.xyz/article.html?slug=' + article.slug);

  // JSON-LD structured data
  var ldJson = document.getElementById('ldjson');
  if (ldJson) {
    var ld = JSON.parse(ldJson.textContent);
    ld.headline = article.title;
    ld.description = article.excerpt || '';
    ld.datePublished = '2026-06-01';
    ld.dateModified = '2026-06-01';
    if (product) {
      ld.image = 'https://www.smrtdesk.xyz/' + product.image;
      ld.about = {
        '@type': 'Product',
        'name': product.title,
        'sku': product.asin,
        'brand': { '@type': 'Brand', 'name': product.brand },
        'aggregateRating': { '@type': 'AggregateRating', 'ratingValue': product.rating, 'reviewCount': product.reviewCount }
      };
    }
    ldJson.textContent = JSON.stringify(ld);
  }

  // OG meta tags
  var ogTitleEl = document.querySelector('[data-bind="ogTitle"]');
  if (ogTitleEl) ogTitleEl.setAttribute('content', article.title + ' | SmrtDesk');
  var ogDescEl = document.querySelector('[data-bind="ogDescription"]');
  if (ogDescEl && article.excerpt) ogDescEl.setAttribute('content', article.excerpt);
  var ogUrlEl = document.querySelector('[data-bind="ogUrl"]');
  if (ogUrlEl) ogUrlEl.setAttribute('content', 'https://www.smrtdesk.xyz/article.html?slug=' + article.slug);
})();

/* Blog Page Renderer */
(function(){
  var blogGrid = document.getElementById('blogGrid');
  if (!blogGrid) return;

  if (typeof ARTICLES === 'undefined' || ARTICLES.length === 0) {
    blogGrid.innerHTML = '<div class="blog-empty"><p>No articles published yet. Check back soon!</p></div>';
    return;
  }

  var currentFilter = 'all';

  // Collect unique categories from articles
  var catMap = {};
  for (var i = 0; i < ARTICLES.length; i++) {
    var cat = ARTICLES[i].category;
    var catName = ARTICLES[i].categoryName || cat;
    if (!catMap[cat]) {
      catMap[cat] = { slug: cat, name: catName, count: 0 };
    }
    catMap[cat].count++;
  }

  // Render category filter pills
  var filterBar = document.getElementById('blogFilterBar');
  if (filterBar) {
    var pillsHtml = '<span class="blog-filter-pill active" data-filter="all">All (' + ARTICLES.length + ')</span>';
    var catKeys = Object.keys(catMap).sort(function(a, b) {
      return catMap[b].count - catMap[a].count;
    });
    for (var k = 0; k < catKeys.length; k++) {
      var c = catMap[catKeys[k]];
      pillsHtml += '<span class="blog-filter-pill" data-filter="' + c.slug + '">' + c.name + ' (' + c.count + ')</span>';
    }
    filterBar.innerHTML = pillsHtml;

    // Click handlers for filter pills
    var pills = filterBar.querySelectorAll('.blog-filter-pill');
    for (var pi = 0; pi < pills.length; pi++) {
      pills[pi].addEventListener('click', function(){
        for (var pj = 0; pj < pills.length; pj++) {
          pills[pj].classList.remove('active');
        }
        this.classList.add('active');
        currentFilter = this.getAttribute('data-filter');
        renderBlogCards(currentFilter);
      });
    }
  }

  // Render sidebar category list
  var sidebarCatList = document.getElementById('blogCategoryList');
  if (sidebarCatList) {
    var catListHtml = '';
    catKeys = Object.keys(catMap).sort(function(a, b) {
      return catMap[b].count - catMap[a].count;
    });
    for (var sk = 0; sk < catKeys.length; sk++) {
      var scC = catMap[catKeys[sk]];
      catListHtml += '<li><a href="javascript:void(0)" class="blog-cat-link" data-filter="' + scC.slug + '">' + scC.name + ' <span class="cat-count">(' + scC.count + ')</span></a></li>';
    }
    sidebarCatList.innerHTML = catListHtml;

    // Sidebar category click handlers
    var sidebarLinks = sidebarCatList.querySelectorAll('.blog-cat-link');
    for (var sl = 0; sl < sidebarLinks.length; sl++) {
      sidebarLinks[sl].addEventListener('click', function(e){
        e.preventDefault();
        var f = this.getAttribute('data-filter');
        // Activate correct pill
        var allPills = filterBar ? filterBar.querySelectorAll('.blog-filter-pill') : [];
        for (var ap = 0; ap < allPills.length; ap++) {
          if (allPills[ap].getAttribute('data-filter') === f) {
            allPills[ap].classList.add('active');
          } else {
            allPills[ap].classList.remove('active');
          }
        }
        currentFilter = f;
        renderBlogCards(f);
        // Scroll to grid on mobile
        blogGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  }

  // Render sidebar popular articles (first 5)
  var hotList = document.getElementById('blogHotList');
  if (hotList) {
    var hotHtml = '';
    var hotCount = Math.min(5, ARTICLES.length);
    for (var hi = 0; hi < hotCount; hi++) {
      hotHtml += '<li><a href="article.html?slug=' + ARTICLES[hi].slug + '">' + ARTICLES[hi].title + '</a></li>';
    }
    hotList.innerHTML = hotHtml;
  }

  // Render blog cards
  function renderBlogCards(filter) {
    var filtered = ARTICLES;
    if (filter && filter !== 'all') {
      filtered = [];
      for (var fi = 0; fi < ARTICLES.length; fi++) {
        if (ARTICLES[fi].category === filter) {
          filtered.push(ARTICLES[fi]);
        }
      }
    }

    var emptyEl = document.getElementById('blogEmpty');
    if (filtered.length === 0) {
      blogGrid.innerHTML = '';
      if (emptyEl) emptyEl.style.display = 'block';
      return;
    }
    if (emptyEl) emptyEl.style.display = 'none';

    var html = '';
    for (var bi = 0; bi < filtered.length; bi++) {
      var a = filtered[bi];
      var imgUrl = a.image || '';
      html += '<div class="blog-card">' +
        '<div class="blog-card__image">' +
          (imgUrl ? '<img src="' + imgUrl + '" alt="' + a.title + '" loading="lazy">' : '<div style="height:100%;background:#e8ecf1;display:flex;align-items:center;justify-content:center;color:#bbb;font-size:2rem;">&#9998;</div>') +
          '<span class="blog-card__tag">' + (a.categoryName || 'Blog') + '</span>' +
        '</div>' +
        '<div class="blog-card__body">' +
          '<h3 class="blog-card__title"><a href="article.html?slug=' + a.slug + '">' + a.title + '</a></h3>' +
          '<p class="blog-card__excerpt">' + (a.excerpt || '') + '</p>' +
          '<div class="blog-card__meta">' +
            '<span>' + (a.date || '') + '</span>' +
            '<a href="article.html?slug=' + a.slug + '" class="blog-card__read-more">Read More </a>' +
          '</div>' +
        '</div>' +
      '</div>';
    }
    blogGrid.innerHTML = html;
  }

  // Initial render
  renderBlogCards('all');
})();
