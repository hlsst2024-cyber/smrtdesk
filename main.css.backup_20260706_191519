  .article-hero {
    padding: 36px 0 28px;
  }
  .article-hero__title {
    font-size: 1.45rem;
  }
  .article-hero__breadcrumb {
    font-size: 0.76rem;
  }
  .article-layout {
    padding: 24px 0 36px;
  }
  .article-body h2 {
    font-size: 1.2rem;
  }
  .article-body h3 {
    font-size: 1.05rem;
  }
  .article-body p {
    font-size: 0.92rem;
  }
  .article-related__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .article-related__grid li a {
