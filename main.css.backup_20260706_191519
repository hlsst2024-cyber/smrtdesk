}
.product-card .card-body .btn-amz {
  display: block;
  width: 100%;
  padding: 7px 0;
  margin-top: auto;
  background: var(--gold);
  color: var(--white);
  font-size: 0.7rem;
  font-weight: 700;
  text-align: center;
  border-radius: 5px;
  text-decoration: none;
  transition: background 0.2s;
  letter-spacing: 0.2px;
