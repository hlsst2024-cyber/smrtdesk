}
.product-card .card-body .stars {
  font-size: 0.7rem;
  color: var(--gold);
  letter-spacing: 0.5px;
  display: flex;
  align-items: center;
  gap: 4px;
  line-height: 1;
}
.product-card .card-body .stars .rating-text {
  font-size: 0.65rem;
  color: var(--text-aux);
  letter-spacing: 0;
}
.product-card .card-body .pro-title {
  font-size: 13px;
  font-weight: 600;
  line-height: 1.3;
  margin: 0;
  color: var(--text-heading);
  text-align: left;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.product-card .card-body .pro-title a { color: inherit; }
.product-card .card-body .pro-title a:hover { color: var(--orange); }
.product-card .card-body .price-range {
  font-size: 0.7rem;
  color: var(--text-body);
  margin: 0;
  text-align: left;
  line-height: 1.2;
}
.product-card .card-body .price-range strong {
